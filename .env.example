# Copy to .env and adjust. docker-compose injects production values directly,
# so this file is mainly for running the app/worker outside Docker.

ENVIRONMENT=development
LOG_LEVEL=INFO

# 302 = temporary (every click reaches us -> full analytics).
# 301 = permanent (browser/CDN caches it -> faster, but you stop seeing clicks).
REDIRECT_STATUS_CODE=302

# --- Backends ---
# Postgres (Docker):
# DATABASE_URL=postgresql+asyncpg://shortener:shortener@localhost:5432/shortener
# SQLite (no infra, dev/CI):
DATABASE_URL=sqlite+aiosqlite:///./shortener.db
REDIS_URL=redis://localhost:6379/0
USE_FAKE_REDIS=false

# --- Short codes ---
CODE_OFFSET=1000000

# --- Cache TTLs (seconds) ---
CACHE_TTL_SECONDS=3600
CACHE_NEGATIVE_TTL_SECONDS=30

# --- Rate limiting (per IP, token bucket) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_PER_SEC=20
